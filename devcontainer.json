{
  "name": "LLM Devcontainer (Shared Submodule)",
  "build": {
    "dockerfile": "images/Dockerfile",
    "context": ".",
    "args": {
      "CLAUDE_CODE_VERSION": "latest",
      "CODEX_VERSION": "latest",
      "GEMINI_CLI_VERSION": "latest"
    }
  },
  "runArgs": ["--init", "--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "updateRemoteUserUID": true,
  "remoteUser": "node",
  "containerUser": "node",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "mounts": [
    "source=llm-claude-config,target=/home/node/.claude,type=volume",
    "source=llm-codex-config,target=/home/node/.codex,type=volume",
    "source=llm-gemini-config,target=/home/node/.gemini,type=volume",
    "source=llm-github-cli-config,target=/home/node/.config/gh,type=volume",
    "source=llm-git-config,target=/home/node/.config/git,type=volume",
    "source=llm-bash-history,target=/commandhistory,type=volume",
    "source=llm-vscode-extensions,target=/home/node/.vscode-server/extensions,type=volume"
  ],
  "containerEnv": {
    "DEVCONTAINER": "true"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "openai.chatgpt",
        "Google.geminicodeassist",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postStartCommand": "sudo /usr/local/bin/fix-volume-perms.sh && sudo /usr/local/bin/init-firewall.sh && (/usr/local/bin/init-workspace.sh || true) && (/usr/local/bin/install-skills.sh || true)"
}
